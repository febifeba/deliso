<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- No analytic_distribution field in the invoice header: the widget
         focuses itself when it renders, and account_invoice_extract crashes
         looking that unknown field up in its box mapping. The button opens
         the wizard, which carries the field in its own dialog. See
         dfd.analytic.bulk.mixin for the trace and the proof. -->
    <record id="view_move_form_dfd_analytic" model="ir.ui.view">
        <field name="name">account.move.form.dfd.analytic.bulk</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_dfd_apply_analytic"
                        type="object"
                        string="Allocate lines"
                        groups="analytic.group_analytic_accounting"
                        invisible="move_type == 'entry'"/>
            </xpath>
            <!-- One column to point at the lines. Odoo offers no selection
                 checkbox inside a list embedded in a form, so this is a real
                 field. Optional and hidden: whoever needs it turns it on
                 once from the column selector, and nobody else ever sees it.
                 Reserved to the same group as the button, so it does not
                 even appear in the selector of those who cannot use it. -->
            <xpath expr="//page[@id='invoice_tab']//list[@name='journal_items']/field[@name='sequence']" position="after">
                <field name="dfd_selected"
                       optional="hide"
                       width="60px"
                       groups="analytic.group_analytic_accounting"/>
            </xpath>
            <!-- The bin sits above the list, where the lines are, not in the
                 header: it is a gesture on the tab, and it must be read next
                 to what it empties. Hidden on a posted document and on an
                 empty one, so it never offers to delete nothing. -->
            <xpath expr="//page[@id='invoice_tab']/field[@name='invoice_line_ids']" position="before">
                <div class="text-end">
                    <button name="action_dfd_clear_lines"
                            type="object"
                            icon="fa-trash-o"
                            string="Empty the lines"
                            class="btn-link text-danger"
                            confirm="Delete every line of this document? Sections and notes go too. This cannot be undone."
                            invisible="state != 'draft' or not invoice_line_ids"/>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
