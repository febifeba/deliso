<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Orders do carry the header field: no digitisation intercepts the
         focus here, and at ordering time you already know which site you are
         buying for. The button stays visible even when the field is empty —
         hiding it made the whole feature undiscoverable. -->
    <record id="purchase_order_form_dfd_analytic" model="ir.ui.view">
        <field name="name">purchase.order.form.dfd.analytic.bulk</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_ref']" position="after">
                <field name="analytic_distribution"
                       widget="analytic_distribution"
                       groups="analytic.group_analytic_accounting"
                       options="{'business_domain': 'purchase_order'}"/>
            </xpath>
            <xpath expr="//header" position="inside">
                <button name="action_dfd_apply_analytic"
                        type="object"
                        string="Allocate lines"
                        groups="analytic.group_analytic_accounting"/>
            </xpath>
        </field>
    </record>
</odoo>
